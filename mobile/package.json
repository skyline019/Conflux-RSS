{
  "name": "conflux-mobile",
  "private": true,
  "version": "0.2.7",
  "description": "汇阅手机版。数据在本机 SQLite，不连接电脑。",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "android": "vite build && cap sync android",
    "apk:release": "node scripts/apk-release.mjs",
    "keystore": "node scripts/ensure-keystore.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.ci.json",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/network": "^7.0.4",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@mozilla/readability": "^0.6.0",
    "@tanstack/react-virtual": "^3.14.23",
    "fts5-sql-bundle": "^1.0.2",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.58.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@tailwindcss/vite": "^4.1.17",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.5"
  }
}
